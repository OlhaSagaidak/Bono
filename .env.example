# Copy to .env and fill in real values. Never commit .env.

# PayPal sandbox (https://developer.paypal.com → Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_PLATFORM_MERCHANT_EMAIL=platform-business@example.com
# A sandbox Personal (buyer) account, for testing payments by hand
PAYPAL_SANDBOX_BUYER_EMAIL=buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=your-sandbox-buyer-password

# Nonprofit verification fee in cents (optional, default 2500 = $25)
VERIFICATION_FEE_CENTS=2500

# Anthropic API (server-side only, claude-haiku-5-5)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Local Postgres with pgvector
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/bono

# Auth.js — generate with: npx auth secret
AUTH_SECRET=generate-a-random-secret
